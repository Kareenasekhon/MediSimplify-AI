# Copy relevant backend values into backend/.env on your production host.
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_DOCS_ENABLED=false
ALLOWED_ORIGINS=https://your-frontend-domain.example
ALLOW_CREDENTIALS=true
MAX_REPORT_SIZE_MB=10
MAX_QUESTION_LENGTH=4000
TEMPORARY_DATA_DIR=/app/temporary_data

# Configure at least one provider.
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_ENABLED=false
DEFAULT_LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDERS=gemini

LOCAL_OCR_ENABLED=true
TESSERACT_CMD=/usr/bin/tesseract
OCR_STRUCTURING_PROVIDER=groq

# Disable local Whisper on a low-memory host, or enable it on a suitable VM.
VOICE_TRANSCRIPTION_ENABLED=false
VOICE_SPEECH_ENABLED=true

# Security hardening
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOADS_PER_MINUTE=5
RATE_LIMIT_QUESTIONS_PER_MINUTE=20
RATE_LIMIT_VOICE_PER_MINUTE=10
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,m4a,ogg,webm,flac
