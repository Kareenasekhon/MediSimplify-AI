# Backend Railway service
APP_ENV=production
DEBUG=false
API_DOCS_ENABLED=false
ALLOWED_ORIGINS=https://your-frontend.up.railway.app
PERSISTENT_DATA_DIR=/var/data
HF_HOME=/var/data/model_cache/huggingface
TESSERACT_CMD=/usr/bin/tesseract
DEFAULT_LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDERS=gemini
GROQ_API_KEY=replace-me
GEMINI_API_KEY=replace-me
OLLAMA_ENABLED=false
VOICE_TRANSCRIPTION_ENABLED=false
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=300
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60

# Frontend Railway service
BACKEND_API_URL=https://your-backend.up.railway.app
REPORT_HISTORY_PATH=/var/data/report_history.json
BACKEND_REQUEST_TIMEOUT_SECONDS=180
BACKEND_CONNECT_TIMEOUT_SECONDS=20

# Phase 10.3 Batch 4 — monitoring and observability
METRICS_ENABLED=true
METRICS_EXCLUDE_HEALTH_CHECKS=true
SLOW_REQUEST_THRESHOLD_MS=3000
