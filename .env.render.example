# Render backend service
APP_ENV=production
DEBUG=false
API_DOCS_ENABLED=false
ALLOWED_ORIGINS=https://medisimplify-web.onrender.com
PERSISTENT_DATA_DIR=/var/data
HF_HOME=/var/data/model_cache/huggingface
TESSERACT_CMD=/usr/bin/tesseract
DEFAULT_LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDERS=gemini
GROQ_API_KEY=replace-me
GEMINI_API_KEY=replace-me
OLLAMA_ENABLED=false
VOICE_TRANSCRIPTION_ENABLED=false

# Render frontend service
# BACKEND_API_HOSTPORT is supplied by render.yaml from the backend service.
REPORT_HISTORY_PATH=/var/data/report_history.json
BACKEND_REQUEST_TIMEOUT_SECONDS=180
BACKEND_CONNECT_TIMEOUT_SECONDS=20
