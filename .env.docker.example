# Docker Compose reads provider settings from backend/.env.
# Copy backend/.env.example to backend/.env and place real secrets there.
# Never commit backend/.env.

# Frontend-to-backend communication is configured automatically in compose.yaml:
# BACKEND_API_URL=http://backend:8000

# Ollama runs on the Windows host and is reached from Docker through:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
