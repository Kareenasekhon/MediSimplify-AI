# ============================================================
# Application environment
# ============================================================
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
API_DOCS_ENABLED=true
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
ALLOW_CREDENTIALS=true
MAX_REPORT_SIZE_MB=5
MAX_QUESTION_LENGTH=4000
TEMPORARY_DATA_DIR=temporary_data

# ============================================================
# LLM providers — configure at least one for AI operations
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
DEFAULT_LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=groq,ollama
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY_SECONDS=0.5

# ============================================================
# OCR and document extraction
# ============================================================
LOCAL_OCR_ENABLED=true
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Docker/Linux example: /usr/bin/tesseract
TESSERACT_CMD=
TESSERACT_LANGUAGES=eng
TESSERACT_CONFIG=--oem 3 --psm 6
OCR_STRUCTURING_PROVIDER=groq
OCR_PDF_DPI=220
OCR_MAX_PDF_PAGES=15

# ============================================================
# RAG
# ============================================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=140

# ============================================================
# Voice assistant
# ============================================================
VOICE_TRANSCRIPTION_ENABLED=true
VOICE_SPEECH_ENABLED=true
VOICE_WHISPER_MODEL=small
VOICE_WHISPER_DEVICE=cpu
VOICE_WHISPER_COMPUTE_TYPE=int8
VOICE_BEAM_SIZE=1
VOICE_MAX_AUDIO_MB=15

# Phase 10.3 security hardening
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOADS_PER_MINUTE=5
RATE_LIMIT_QUESTIONS_PER_MINUTE=20
RATE_LIMIT_VOICE_PER_MINUTE=10
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,m4a,ogg,webm,flac

# ============================================================
# Phase 10.3 Batch 2 — performance tuning
# ============================================================
PROVIDER_INSTANCE_CACHE_ENABLED=true
HTTP_MAX_CONNECTIONS=20
HTTP_MAX_KEEPALIVE_CONNECTIONS=10
DOCUMENT_MAX_PDF_PAGES=30
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_CACHE_SIZE=256
MAX_IN_MEMORY_VECTOR_STORES=32
CHAT_HISTORY_MAX_MESSAGES=12
WHISPER_CPU_THREADS=0
WHISPER_NUM_WORKERS=1
