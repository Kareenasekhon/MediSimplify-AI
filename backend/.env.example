HOST=127.0.0.1
PORT=8000
ENV=development
LOG_LEVEL=INFO

# Phase 2 multimodal extraction and Phase 3 text generation
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional cloud fallback
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

DEFAULT_LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=groq,ollama
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY_SECONDS=0.5

# Phase 6 RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=140

# Local OCR fallback (used when Gemini Vision is unavailable/quota-limited)
LOCAL_OCR_ENABLED=true
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
TESSERACT_LANGUAGES=eng
TESSERACT_CONFIG=--oem 3 --psm 6
# Use groq for fast cloud structuring, or ollama for fully local structuring
OCR_STRUCTURING_PROVIDER=groq
OCR_PDF_DPI=220
OCR_MAX_PDF_PAGES=15

# Ollama local LLM
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Phase 8 - Voice Assistant
VOICE_TRANSCRIPTION_ENABLED=true
VOICE_SPEECH_ENABLED=true
VOICE_WHISPER_MODEL=small
VOICE_WHISPER_DEVICE=cpu
VOICE_WHISPER_COMPUTE_TYPE=int8
VOICE_BEAM_SIZE=5
VOICE_MAX_AUDIO_MB=15
